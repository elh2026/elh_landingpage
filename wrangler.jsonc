{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "elh-vn",
  "main": "./worker-production.ts",
  "compatibility_date": "2026-09-11",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "elh.vn",
      "custom_domain": true,
    },
    {
      "pattern": "www.elh.vn",
      "custom_domain": true,
    },
  ],
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page",
    "html_handling": "force-trailing-slash",
  },
}
