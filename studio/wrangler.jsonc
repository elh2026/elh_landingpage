{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "elh-admin",
  "compatibility_date": "2026-09-12",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "admin.elh.vn",
      "custom_domain": true,
    },
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
    },
  },
}
